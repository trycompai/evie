{
  "name": "@evie/desktop",
  "productName": "Evie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Evie desktop shell: a tray-resident macOS app that owns an Evie server and a window onto it.",
  "main": "out/main.cjs",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "bundle": "node scripts/build.mjs",
    "build": "bun run icons && bun run bundle",
    "package": "bun run build && node scripts/package.mjs",
    "dev": "bun run package && EVIE_HOME=../../.evie ./out/Evie.app/Contents/MacOS/Evie",
    "lint": "eslint",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@evie/shared": "workspace:*"
  },
  "devDependencies": {
    "@evie/eslint-config": "workspace:*",
    "@evie/server": "workspace:*",
    "@evie/typescript-config": "workspace:*",
    "@evie/web": "workspace:*",
    "@types/node": "^24.13.3",
    "electron": "^40.1.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.1",
    "globals": "^17.11.0",
    "typescript": "5.9.2"
  }
}
