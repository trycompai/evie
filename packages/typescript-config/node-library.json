{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // Every internal package in this workspace is just-in-time: the consumer's
    // bundler (Vite) or runtime (tsx / node --experimental-strip-types) reads
    // the source. Nothing emits, so resolution follows the bundler's rules.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // Imports carry the .ts extension so Node 24 type-stripping and Vite both
    // resolve them without a build step. Safe with noEmit.
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2023"],
    "target": "ES2023"
  }
}
